# Hồ sơ chạy thử: Node.js >= 22.13, SQLite tích hợp, 36 bảng lõi.
DB_DRIVER=sqlite
SQLITE_PATH=backend/data/qlsv.db
PORT=5173
# Set 1 only for local demo with public synthetic accounts.
SEED_DEMO=1
# MySQL profile (database must already exist):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=qlsv
DB_PASSWORD=
DB_NAME=qlsv
# Production: NODE_ENV=production, HTTPS and exact APP_ORIGIN required.
# APP_ORIGIN=https://your-school.example
# AI của đồ án: cấu hình sẵn Gemini; chỉ cần nhập API key riêng trên máy.
# Chạy `npm run ai:setup` để tạo/cập nhật .env an toàn (không chép khóa vào mã nguồn).
# Khi mất kết nối AI, báo lỗi thay vì giả làm AI bằng mẫu câu cố định.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=30000
AI_REQUIRE_LIVE=1
ALLOW_OFFICIAL_PUBLICATION=0
# Only for a NEW non-demo database; required by npm run db:bootstrap.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_STAFF_USERNAME=
# BOOTSTRAP_STAFF_EMAIL=
# BOOTSTRAP_STAFF_PASSWORD=
# Docker MySQL only:
# MYSQL_ROOT_PASSWORD=

# Hỏi đáp ngoài hệ thống: Gemini có thể tra cứu Google Search và hiển thị nguồn.
AI_WEB_SEARCH=1
