{
  "name": "lac-hong-university-v0621",
  "version": "0.6.21",
  "private": true,
  "type": "module",
  "description": "Quản lý đại học - frontend JavaScript ES Modules theo phân hệ, backend Node.js, MySQL/SQLite",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "css": "tailwindcss -i frontend/src/styles/theme.css -o frontend/src/styles/generated.css --minify",
    "css:watch": "tailwindcss -i frontend/src/styles/theme.css -o frontend/src/styles/generated.css --watch",
    "start": "node --env-file-if-exists=.env backend/src/server.js",
    "db:init": "node --env-file-if-exists=.env backend/scripts/init.mjs",
    "db:seed": "node --env-file-if-exists=.env backend/scripts/seed.mjs",
    "dev:frontend": "node scripts/serve.mjs",
    "dev:backend": "node --env-file-if-exists=.env backend/src/server.js",
    "db:bootstrap": "node --env-file-if-exists=.env backend/scripts/bootstrap.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "check:local": "node --env-file-if-exists=.env scripts/check-local.mjs",
    "check:ai": "node --env-file-if-exists=.env scripts/check-ai.mjs",
    "ai:setup": "node scripts/configure-ai.mjs"
  },
  "devDependencies": {
    "tailwindcss": "^4.1.0",
    "@tailwindcss/cli": "^4.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "mysql2": "^3.14.0"
  }
}
